# KMR CRM Environment Configuration
# Copy this file to .env or .env.local

# Optional Secret Key for LocalStorage encryption (AES)
# Leave blank or commented out to keep plain localStorage
VITE_SECRET_KEY=kmr_crm_secret_key_2026

# Right-click & Devtools behavior:
# Set to 'true' in local development to allow inspect element and devtools shortcuts
# Set to 'false' in production builds
VITE_ALLOW_DEVTOOLS=true

# API Base URL (if overriding default https://kmrlive.in/public/api)
# VITE_API_BASE_URL=https://kmrlive.in/public/api
